{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MRMhub Integrator GUI",
  "version": "1.2.2",
  "identifier": "org.slinghub.mrmhub.integrator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MRMhub Integrator GUI [v1.2.2]",
        "width": 1180,
        "height": 780,
        "minWidth": 840,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "peak detection and integration for targeted mrm data",
    "category": "Medical"
  }
}
