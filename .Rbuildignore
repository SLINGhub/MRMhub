^.*\.Rproj$
^\.Rproj\.user$
^\.github$
^\.covrignore$
^\.travis\.yml$
^codecov\.yml$
^_pkgdown\.yml$
^pkgdown$
^docs$
^doc$
^Meta$
^data-raw$
^dev$
^dev-notes$
^man-roxygen$
^air\.toml$
^CODE_OF_CONDUCT\.md$
^LICENSE\.md$
^mydata\.csv$
# Repo-level files that are not part of the R package
^integrator$
^integrator_w_gui$
^integrator_viz$
^MRMhub-Dataset1$
^docs-site$
^docs-review$
^CLAUDE\.md$
^plan-.*\.prompt\.md$
^justfile$
^\.vscode$
^\.claude$
^\.agents$
^skills-lock\.json$
^.*\.tar\.gz$
# Large article demo data — needed by pkgdown, must not ship in the package tarball
^vignettes/articles/datasets$
# Build hygiene: dir placeholders + stray rendered-article output (knitr/Quarto _files)
\.gitkeep$
^man/figures/screencasts$
^vignettes/articles/.*_files
# Stray default-device plot dump produced by base-graphics tests/examples
Rplots\.pdf$

# Local, non-package share doc (INTEGRATOR fork review)
^integrator-fork-review\.html$
